  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justin-coders/code-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/justin-coders/code-guardian/issues"
  },
  "homepage": "https://github.com/justin-coders/code-guardian#readme",
  "keywords": [
    "claude-code",
    "cursor",
    "windsurf",
    "devin",
    "codex",
    "gemini",
    "antigravity",
    "mcp",
    "production",
    "quality",
    "audit",
    "ai-agent",
    "cross-agent",
    "code-review",
    "ci-cd"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/stdio-server.js",
    "start:http": "CODE_GUARDIAN_TRANSPORT=http node src/http-server.js",
    "test": "node --test tests/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/**/*.test.js",
    "lint": "npx eslint src tests",
    "format": "npx prettier --write src tests"
  },
