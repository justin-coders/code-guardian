{
  "name": "code-guardian",
  "description": "Cross-agent production-readiness enforcer for AI coding tools. Audits codebases against industry standards, generates production-grade code with reference patterns, and works across all major AI coding agents.",
  "version": "2.0.0",
  "author": {
    "name": "justin-coders"
  },
  "license": "MIT",
  "type": "module",
