{
  "mcpServers": {
    "code-guardian": {
      "type": "stdio",
      "command": "node",
      "args": ["src/stdio-server.js"],
      "cwd": "${workspaceFolder}",
      "env": {
        "CODE_GUARDIAN_TRANSPORT": "stdio"
      }
    },
    "code-guardian-http": {
      "type": "http",
      "url": "http://localhost:8765/sse",
      "headers": {}
    }
  }
}